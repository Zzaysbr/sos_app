+        dueJobs: _runtimeDueJobs,
+        lastSelectedPeer: _runtimeSelectedPeer,
+        lastSkipReason: _runtimeSkipReason,
+        lastForwardAttempt: _runtimeForwardAttempt,
+        lastDurableReceipt: _runtimeDurableReceipt,
+      ),
+    );
+  }
