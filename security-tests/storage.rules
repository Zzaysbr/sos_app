rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /chat-archive/{ownerId}/{sosId}/{messageId} {
      allow read: if request.auth != null
        && request.auth.uid == ownerId
        ;
      allow write: if request.auth != null
        && request.auth.uid == ownerId
        && request.resource.size < 10485760;
    }
  }
}
