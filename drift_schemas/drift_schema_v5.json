  "fixed_sql": [
    {
      "name": "sos_messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sos_messages\" (\"id\" TEXT NOT NULL, \"owner_id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"message\" TEXT NULL, \"latitude\" REAL NULL, \"longitude\" REAL NULL, \"status\" TEXT NOT NULL, \"sync_state\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sos_sync_queue",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sos_sync_queue\" (\"queue_id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"sos_id\" TEXT NOT NULL, \"owner_id\" TEXT NOT NULL, \"operation\" TEXT NOT NULL, \"payload\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "ble_outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ble_outbox\" (\"message_id\" TEXT NOT NULL, \"sos_id\" TEXT NOT NULL, \"destination_id\" TEXT NULL, \"schema_version\" INTEGER NOT NULL, \"payload\" TEXT NOT NULL, \"state\" TEXT NOT NULL, \"retry_count\" INTEGER NOT NULL DEFAULT 0, \"next_retry_at\" INTEGER NULL, \"last_attempt_at\" INTEGER NULL, \"last_error\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"acknowledged_at\" INTEGER NULL, PRIMARY KEY (\"message_id\"));"
        }
      ]
    },
    {
      "name": "ble_inbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ble_inbox\" (\"message_id\" TEXT NOT NULL, \"sos_id\" TEXT NOT NULL, \"sender_device_id\" TEXT NULL, \"schema_version\" INTEGER NOT NULL, \"payload\" TEXT NOT NULL, \"processing_state\" TEXT NOT NULL, \"received_at\" INTEGER NOT NULL, \"persisted_at\" INTEGER NULL, \"acknowledgement_status\" TEXT NULL, PRIMARY KEY (\"message_id\"));"
        }
      ]
    },
    {
      "name": "chat_messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chat_messages\" (\"message_id\" TEXT NOT NULL, \"sos_id\" TEXT NOT NULL, \"owner_id\" TEXT NOT NULL, \"sender_id\" TEXT NOT NULL, \"recipient_id\" TEXT NULL, \"message_type\" TEXT NOT NULL, \"text_content\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"delivery_status\" TEXT NOT NULL, \"attachment_path\" TEXT NULL, \"attachment_mime_type\" TEXT NULL, \"attachment_name\" TEXT NULL, \"remote_message_id\" TEXT NULL, \"transport_metadata\" TEXT NULL, PRIMARY KEY (\"message_id\"));"
        }
      ]
    }
